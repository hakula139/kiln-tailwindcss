{
  "name": "@kiln-ssg/tailwindcss",
  "version": "0.1.3",
  "description": "Tailwind CSS processor for kiln static sites",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hakula139/kiln-tailwindcss.git"
  },
  "homepage": "https://github.com/hakula139/kiln-tailwindcss",
  "bugs": {
    "url": "https://github.com/hakula139/kiln-tailwindcss/issues"
  },
  "type": "module",
  "bin": {
    "kiln-tailwindcss": "compiler.mjs"
  },
  "files": [
    "compiler.mjs"
  ],
  "dependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/typography": "0.5.20"
  },
  "bundleDependencies": [
    "@tailwindcss/typography"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "npm run format:prettier && npm run format:markdown",
    "format:markdown": "dprint check",
    "format:prettier": "prettier --check .",
    "lint": "npm run lint:md && npm run lint:js",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2 \"*.md\"",
    "spellcheck": "cspell --dot --no-progress \"**/*\"",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cspell": "^10.4.0",
    "dprint": "^0.64.3",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "^11.0.3"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    },
    "eslint": {
      "minimatch": "^11.0.3"
    },
    "markdownlint": {
      "re2js": "^2.9.1"
    },
    "micromark-extension-math": {
      "katex": "^0.19.1"
    }
  }
}
